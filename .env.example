# Local services
POSTGRES_USER=bidding_user
POSTGRES_PASSWORD=bidding_password
POSTGRES_DB=bidding_db
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_ROOT_USER=bidding_minio_user
MINIO_ROOT_PASSWORD=bidding_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
DATABASE_URL=postgresql://bidding_user:bidding_password@localhost:5433/bidding_db
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# OpenAI-compatible chat model
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=
LLM_MODEL=kimi-k2.6

# OpenAI-compatible embeddings
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_DIM=1024

# Repository-relative paths are resolved from the repo root.
VAULT_ROOT=vault
DEMO_TENDER_PATH=vault/10-Knowledge/Evergreen/招标文件案例.md
BIDDING_DATA_DIR=workspaces/api-projects

# Frontend
NEXT_PUBLIC_BIDDING_API_BASE_URL=http://localhost:8000
BID_ROUTE_STORAGE_STATE=.auth/bid-route-storage-state.json
