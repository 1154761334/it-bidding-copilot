# IT Bidding Copilot - 环境变量配置
# 复制此文件为 .env 并填入你的真实配置

# === LLM API 配置 ===
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# === 应用配置 ===
APP_DATA_DIR=./data
VECTOR_STORE_DIR=./data/knowledge_base
ENTERPRISE_DIR=./data/enterprises

# === RAGFlow (可选，预留接口) ===
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=
