# Ignore workspaces and their generated contents
workspaces/

# Ignore local nested frontend checkout managed by its own Git repository
frontend/

# Ignore internal company knowledge vault and sensitive data
vault/

# Ignore generated backend smoke/evaluation artifacts
backend/tests/output/

# Ignore large Office source documents kept local or converted into the vault
*.docx

# Ignore Python virtual environments
.venvs/
env/
venv/
.env

# Ignore cache files
__pycache__/
*.pyc
.pytest_cache/

# Ignore logs
*.log

# Ignore IDE specific files
.vscode/
.idea/
.DS_Store
