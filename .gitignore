# Ignore workspaces and their generated contents
workspaces/

# Ignore internal company knowledge vault and sensitive data
vault/

# Ignore generated backend smoke/evaluation artifacts
backend/tests/output/

# Ignore large Office source documents kept local or converted into the vault
*.docx

# Ignore frontend local metadata, dependencies, builds, and auth state
frontend/.git/
frontend/.env.desktop
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/public/_spa/
frontend/public/spa/
frontend/.auth/
frontend/*.tsbuildinfo

# Ignore Python virtual environments
.venvs/
env/
venv/
.env

# Ignore cache files
__pycache__/
*.pyc
.pytest_cache/

# Ignore logs
*.log

# Ignore IDE specific files
.vscode/
.idea/
.DS_Store
